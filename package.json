{
  "name": "deckora",
  "version": "0.1.0",
  "private": true,
  "description": "Deckora - PWA moderna de juegos de cartas clásicos",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @deckora/web dev",
    "dev:server": "pnpm --filter @deckora/server dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
